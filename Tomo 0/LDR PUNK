const int buzzerPin = 9;
const int ldrPin = A0;

void setup() {
  Serial.begin(9600);
  pinMode(buzzerPin, OUTPUT);
  randomSeed(analogRead(A0));
}

void loop() {
  int ldrValue = analogRead(ldrPin);
  
  int freqMin = map(ldrValue, 0, 1023, 20, 200);
  int freqMax = map(ldrValue, 0, 1023, 500, 2000);
  
  freqMin = constrain(freqMin, 20, 200);
  freqMax = constrain(freqMax, 500, 2500);
  
  int randomFreq = random(freqMin, freqMax + 1);
  int duracion = random(150, 400);
  
  Serial.print(ldrValue);
  Serial.print(" ");
  Serial.println(randomFreq);
  
  tone(buzzerPin, randomFreq, duracion);
  delay(20);
}
